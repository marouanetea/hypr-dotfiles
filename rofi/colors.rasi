* {
	primary: #81d5cc;
	primary-fixed: #9df2e8;
	primary-fixed-dim: #81d5cc;
	on-primary: #003532;
	on-primary-fixed: #00201d;
	on-primary-fixed-variant: #00504b;
	primary-container: #005c56;
	on-primary-container: #ffffff;
	secondary: #b1ccc8;
	secondary-fixed: #cce8e4;
	secondary-fixed-dim: #b1ccc8;
	on-secondary: #1a3330;
	on-secondary-fixed: #051f1d;
	on-secondary-fixed-variant: #324b48;
	secondary-container: #3d5754;
	on-secondary-container: #ffffff;
	tertiary: #afc9e7;
	tertiary-fixed: #cee5ff;
	tertiary-fixed-dim: #afc9e7;
	on-tertiary: #163148;
	on-tertiary-fixed: #001d33;
	on-tertiary-fixed-variant: #2f4961;
	tertiary-container: #3b546d;
	on-tertiary-container: #ffffff;
	error: #ffb4ab;
	on-error: #660004;
	error-container: #a7060f;
	on-error-container: #ffffff;
	surface: #0e1514;
	on-surface: #dde4e2;
	on-surface-variant: #bec9c6;
	outline: #899391;
	outline-variant: #4a5452;
	shadow: #000000;
	scrim: #000000;
	inverse-surface: #dde4e2;
	inverse-on-surface: #2b3231;
	inverse-primary: #006a63;
	surface-dim: #0e1514;
	surface-bright: #363d3c;
	surface-container-lowest: #080e0d;
	surface-container-low: #171d1c;
	surface-container: #1c2222;
	surface-container-high: #262d2c;
	surface-container-highest: #313837;

	/** ==== Transparent surfaces ==== **/
	surface-transparent: #0e1514a0;
	surface-dim-transparent: #0e1514a0;
	surface-bright-transparent: #363d3ca0;
	surface-container-lowest-transparent: #080e0da0;
	surface-container-low-transparent: #171d1ca0;
	surface-container-transparent: #1c2222a0;
	surface-container-high-transparent: #262d2ca0;
	surface-container-highest-transparent: #313837a0;
}
