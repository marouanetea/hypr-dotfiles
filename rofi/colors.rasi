* {
	primary: #8fcef3;
	primary-fixed: #c4e7ff;
	primary-fixed-dim: #8fcef3;
	on-primary: #003347;
	on-primary-fixed: #001e2c;
	on-primary-fixed-variant: #004c69;
	primary-container: #015878;
	on-primary-container: #ffffff;
	secondary: #b5c9d7;
	secondary-fixed: #d1e5f4;
	secondary-fixed-dim: #b5c9d7;
	on-secondary: #1e313c;
	on-secondary-fixed: #0a1e28;
	on-secondary-fixed-variant: #374955;
	secondary-container: #425460;
	on-secondary-container: #ffffff;
	tertiary: #cac1e9;
	tertiary-fixed: #e6deff;
	tertiary-fixed-dim: #cac1e9;
	on-tertiary: #302a4a;
	on-tertiary-fixed: #1d1736;
	on-tertiary-fixed-variant: #484264;
	tertiary-container: #544d6f;
	on-tertiary-container: #ffffff;
	error: #ffb4ab;
	on-error: #660004;
	error-container: #a7060f;
	on-error-container: #ffffff;
	surface: #0f1417;
	on-surface: #dfe3e7;
	on-surface-variant: #c0c7cd;
	outline: #8b9297;
	outline-variant: #4c5358;
	shadow: #000000;
	scrim: #000000;
	inverse-surface: #dfe3e7;
	inverse-on-surface: #2c3134;
	inverse-primary: #1c6586;
	surface-dim: #0f1417;
	surface-bright: #373c3f;
	surface-container-lowest: #090e11;
	surface-container-low: #181d20;
	surface-container: #1d2225;
	surface-container-high: #282c30;
	surface-container-highest: #32373b;

	/** ==== Transparent surfaces ==== **/
	surface-transparent: #0f1417a0;
	surface-dim-transparent: #0f1417a0;
	surface-bright-transparent: #373c3fa0;
	surface-container-lowest-transparent: #090e11a0;
	surface-container-low-transparent: #181d20a0;
	surface-container-transparent: #1d2225a0;
	surface-container-high-transparent: #282c30a0;
	surface-container-highest-transparent: #32373ba0;
}
