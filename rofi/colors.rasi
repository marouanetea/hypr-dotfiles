* {
	primary: #6ed2ff;
	primary-fixed: #bfe8ff;
	primary-fixed-dim: #6ed2ff;
	on-primary: #003345;
	on-primary-fixed: #001f2b;
	on-primary-fixed-variant: #004d65;
	primary-container: #005975;
	on-primary-container: #ffffff;
	secondary: #aec9e6;
	secondary-fixed: #cee5ff;
	secondary-fixed-dim: #aec9e6;
	on-secondary: #153148;
	on-secondary-fixed: #001d33;
	on-secondary-fixed-variant: #2f4961;
	secondary-container: #3a546d;
	on-secondary-container: #ffffff;
	tertiary: #b0c7f9;
	tertiary-fixed: #d8e2ff;
	tertiary-fixed-dim: #b0c7f9;
	on-tertiary: #152e57;
	on-tertiary-fixed: #001a40;
	on-tertiary-fixed-variant: #304671;
	tertiary-container: #3b527d;
	on-tertiary-container: #ffffff;
	error: #ffb4ab;
	on-error: #660004;
	error-container: #a7060f;
	on-error-container: #ffffff;
	surface: #0a151a;
	on-surface: #d9e4eb;
	on-surface-variant: #bdc8cf;
	outline: #889299;
	outline-variant: #495359;
	shadow: #000000;
	scrim: #000000;
	inverse-surface: #d9e4eb;
	inverse-on-surface: #283237;
	inverse-primary: #006686;
	surface-dim: #0a151a;
	surface-bright: #333d43;
	surface-container-lowest: #050e13;
	surface-container-low: #131d23;
	surface-container: #192328;
	surface-container-high: #232d33;
	surface-container-highest: #2e383e;

	/** ==== Transparent surfaces ==== **/
	surface-transparent: #0a151aa0;
	surface-dim-transparent: #0a151aa0;
	surface-bright-transparent: #333d43a0;
	surface-container-lowest-transparent: #050e13a0;
	surface-container-low-transparent: #131d23a0;
	surface-container-transparent: #192328a0;
	surface-container-high-transparent: #232d33a0;
	surface-container-highest-transparent: #2e383ea0;
}
