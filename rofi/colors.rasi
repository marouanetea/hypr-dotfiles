* {
	primary: #ffaaf5;
	primary-fixed: #ffd7f6;
	primary-fixed-dim: #ffaaf5;
	on-primary: #580059;
	on-primary-fixed: #380038;
	on-primary-fixed-variant: #800082;
	primary-container: #930095;
	on-primary-container: #ffffff;
	secondary: #e9b9d2;
	secondary-fixed: #ffd8eb;
	secondary-fixed-dim: #e9b9d2;
	on-secondary: #452438;
	on-secondary-fixed: #2f1124;
	on-secondary-fixed-variant: #5f3c50;
	secondary-container: #6c465c;
	on-secondary-container: #ffffff;
	tertiary: #fcb2c9;
	tertiary-fixed: #ffd9e3;
	tertiary-fixed-dim: #fcb2c9;
	on-tertiary: #4f1e31;
	on-tertiary-fixed: #370a1e;
	on-tertiary-fixed-variant: #6b3649;
	tertiary-container: #784054;
	on-tertiary-container: #ffffff;
	error: #ffb4ab;
	on-error: #660004;
	error-container: #a7060f;
	on-error-container: #ffffff;
	surface: #1a1018;
	on-surface: #f0dde9;
	on-surface-variant: #d3c2cd;
	outline: #9c8c97;
	outline-variant: #5b4e58;
	shadow: #000000;
	scrim: #000000;
	inverse-surface: #f0dde9;
	inverse-on-surface: #382d36;
	inverse-primary: #a800aa;
	surface-dim: #1a1018;
	surface-bright: #443841;
	surface-container-lowest: #130a12;
	surface-container-low: #231921;
	surface-container: #281e26;
	surface-container-high: #332831;
	surface-container-highest: #3f333c;

	/** ==== Transparent surfaces ==== **/
	surface-transparent: #1a1018cc;
	surface-dim-transparent: #1a1018cc;
	surface-bright-transparent: #443841cc;
	surface-container-lowest-transparent: #130a12cc;
	surface-container-low-transparent: #231921cc;
	surface-container-transparent: #281e26cc;
	surface-container-high-transparent: #332831cc;
	surface-container-highest-transparent: #3f333ccc;
}
