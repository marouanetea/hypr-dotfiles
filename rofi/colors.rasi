* {
	primary: #aec6ff;
	primary-fixed: #d8e2ff;
	primary-fixed-dim: #aec6ff;
	on-primary: #102d5e;
	on-primary-fixed: #001a43;
	on-primary-fixed-variant: #2c4678;
	primary-container: #385184;
	on-primary-container: #ffffff;
	secondary: #bfc6dc;
	secondary-fixed: #dbe2f9;
	secondary-fixed-dim: #bfc6dc;
	on-secondary: #272f40;
	on-secondary-fixed: #141b2c;
	on-secondary-fixed-variant: #3f4759;
	secondary-container: #4a5264;
	on-secondary-container: #ffffff;
	tertiary: #dfbbde;
	tertiary-fixed: #fcd7fb;
	tertiary-fixed-dim: #dfbbde;
	on-tertiary: #3f2641;
	on-tertiary-fixed: #2a132d;
	on-tertiary-fixed-variant: #583e5a;
	tertiary-container: #644966;
	on-tertiary-container: #ffffff;
	error: #ffb4ab;
	on-error: #660004;
	error-container: #a7060f;
	on-error-container: #ffffff;
	surface: #121318;
	on-surface: #e2e2e9;
	on-surface-variant: #c5c6d0;
	outline: #8e9099;
	outline-variant: #4f525a;
	shadow: #000000;
	scrim: #000000;
	inverse-surface: #e2e2e9;
	inverse-on-surface: #2f3036;
	inverse-primary: #455e91;
	surface-dim: #121318;
	surface-bright: #3a3b41;
	surface-container-lowest: #0b0d12;
	surface-container-low: #1a1c21;
	surface-container: #1f2126;
	surface-container-high: #2a2b31;
	surface-container-highest: #35363c;

	/** ==== Transparent surfaces ==== **/
	surface-transparent: #121318a0;
	surface-dim-transparent: #121318a0;
	surface-bright-transparent: #3a3b41a0;
	surface-container-lowest-transparent: #0b0d12a0;
	surface-container-low-transparent: #1a1c21a0;
	surface-container-transparent: #1f2126a0;
	surface-container-high-transparent: #2a2b31a0;
	surface-container-highest-transparent: #35363ca0;
}
