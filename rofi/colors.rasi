* {
	primary: #8ad0ee;
	primary-fixed: #bbe9ff;
	primary-fixed-dim: #8ad0ee;
	on-primary: #003343;
	on-primary-fixed: #001f29;
	on-primary-fixed-variant: #004d63;
	primary-container: #005971;
	on-primary-container: #ffffff;
	secondary: #b4cad5;
	secondary-fixed: #cfe6f2;
	secondary-fixed-dim: #b4cad5;
	on-secondary: #1d323a;
	on-secondary-fixed: #081e26;
	on-secondary-fixed-variant: #354a53;
	secondary-container: #40555e;
	on-secondary-container: #ffffff;
	tertiary: #c5c3ea;
	tertiary-fixed: #e2dfff;
	tertiary-fixed-dim: #c5c3ea;
	on-tertiary: #2c2c4b;
	on-tertiary-fixed: #181837;
	on-tertiary-fixed-variant: #444464;
	tertiary-container: #4f4f70;
	on-tertiary-container: #ffffff;
	error: #ffb4ab;
	on-error: #660004;
	error-container: #a7060f;
	on-error-container: #ffffff;
	surface: #0f1417;
	on-surface: #dee3e6;
	on-surface-variant: #c0c8cc;
	outline: #8a9296;
	outline-variant: #4b5357;
	shadow: #000000;
	scrim: #000000;
	inverse-surface: #dee3e6;
	inverse-on-surface: #2c3134;
	inverse-primary: #0e6681;
	surface-dim: #0f1417;
	surface-bright: #373c3f;
	surface-container-lowest: #090e10;
	surface-container-low: #181d1f;
	surface-container: #1d2225;
	surface-container-high: #272c2f;
	surface-container-highest: #32373a;

	/** ==== Transparent surfaces ==== **/
	surface-transparent: #0f1417a0;
	surface-dim-transparent: #0f1417a0;
	surface-bright-transparent: #373c3fa0;
	surface-container-lowest-transparent: #090e10a0;
	surface-container-low-transparent: #181d1fa0;
	surface-container-transparent: #1d2225a0;
	surface-container-high-transparent: #272c2fa0;
	surface-container-highest-transparent: #32373aa0;
}
