* {
	primary: #dcb9f8;
	primary-fixed: #f1daff;
	primary-fixed-dim: #dcb9f8;
	on-primary: #3e2256;
	on-primary-fixed: #290c41;
	on-primary-fixed-variant: #573a70;
	primary-container: #63457c;
	on-primary-container: #ffffff;
	secondary: #d1c1d9;
	secondary-fixed: #eeddf6;
	secondary-fixed-dim: #d1c1d9;
	on-secondary: #352b3d;
	on-secondary-fixed: #211829;
	on-secondary-fixed-variant: #4e4256;
	secondary-container: #594d62;
	on-secondary-container: #ffffff;
	tertiary: #f3b7bc;
	tertiary-fixed: #ffdadc;
	tertiary-fixed-dim: #f3b7bc;
	on-tertiary: #4a2328;
	on-tertiary-fixed: #321015;
	on-tertiary-fixed-variant: #663a3f;
	tertiary-container: #72454a;
	on-tertiary-container: #ffffff;
	error: #ffb4ab;
	on-error: #660004;
	error-container: #a7060f;
	on-error-container: #ffffff;
	surface: #151217;
	on-surface: #e8e0e8;
	on-surface-variant: #cdc4ce;
	outline: #968e98;
	outline-variant: #565059;
	shadow: #000000;
	scrim: #000000;
	inverse-surface: #e8e0e8;
	inverse-on-surface: #332f35;
	inverse-primary: #705289;
	surface-dim: #151217;
	surface-bright: #3e3a40;
	surface-container-lowest: #0f0c11;
	surface-container-low: #1e1b20;
	surface-container: #242026;
	surface-container-high: #2e2a30;
	surface-container-highest: #39353b;

	/** ==== Transparent surfaces ==== **/
	surface-transparent: #151217a0;
	surface-dim-transparent: #151217a0;
	surface-bright-transparent: #3e3a40a0;
	surface-container-lowest-transparent: #0f0c11a0;
	surface-container-low-transparent: #1e1b20a0;
	surface-container-transparent: #242026a0;
	surface-container-high-transparent: #2e2a30a0;
	surface-container-highest-transparent: #39353ba0;
}
